{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(python3 -m http.server *)",
      "Bash(npx serve *)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:support.claude.com)",
      "WebFetch(domain:academy.claude.com)",
      "WebFetch(domain:agents.md)",
      "WebFetch(domain:agentskills.io)",
      "WebFetch(domain:modelcontextprotocol.io)"
    ],
    "deny": [
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git stash *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git tag *)",
      "Bash(git remote *)",
      "Bash(git worktree *)",
      "Bash(git update-ref *)",
      "Bash(git symbolic-ref *)",
      "Bash(git filter-branch *)",
      "Bash(git config *)",
      "Bash(git -C *)",
      "Bash(git -c *)",
      "Bash(gh pr *)",
      "Bash(gh repo *)",
      "Bash(gh release *)",
      "Bash(gh api *)",
      "Bash(gh workflow *)",
      "Agent(isolation:worktree)",
      "EnterWorktree",
      "Edit(/.git/**)",
      "Edit(/.gitignore)",
      "Edit(/.claude/settings.json)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}